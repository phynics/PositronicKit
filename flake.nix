{
  description = "PositronicKit dev shell pinned to the swift.org 6.4 toolchain";

  inputs = {
    nixpkgs.url = "github:nixos/nixpkgs/nixos-unstable";
  };

  outputs = { self, nixpkgs }:
    let
      # Nixpkgs dropped x86_64-darwin, so the flake names the supported systems
      # instead of using eachDefaultSystem.
      systems = [
        "x86_64-linux"
        "aarch64-linux"
        "aarch64-darwin"
      ];

      forAllSystems = f: nixpkgs.lib.genAttrs systems (system: f system);

      swiftVersion = "6.4.0";

      # Swift toolchain archives published by swift.org. The block between the
      # markers is generated by Scripts/update-flake-swift.sh, which refreshes
      # the URLs and the SHA-256 hashes for a new toolchain version.
      # BEGIN swift-distributions (generated by Scripts/update-flake-swift.sh)
      swiftDistributions = {
        x86_64-linux = {
          url = "https://download.swift.org/swift-6.4.0-release/ubuntu2404/swift-6.4.0-RELEASE/swift-6.4.0-RELEASE-ubuntu24.04.tar.gz";
          hash = "sha256-afeytNvOYJC2ySGUtxFJoFfhYmkJO1qd3tOK/EoFCU4=";
        };
        aarch64-linux = {
          url = "https://download.swift.org/swift-6.4.0-release/ubuntu2404-aarch64/swift-6.4.0-RELEASE/swift-6.4.0-RELEASE-ubuntu24.04-aarch64.tar.gz";
          hash = "sha256-IerP5XEZRxfSacweADBTO77mEx396CzU+c+8JRLjVKk=";
        };
      };
      # END swift-distributions

      # The Ubuntu 24.04 toolchain links SONAMEs that differ from the ones
      # nixpkgs ships today: libxml2.so.2 versus libxml2.so.16 and libedit.so.2
      # versus libedit.so.0. Provide ABI-compatible copies under the expected
      # SONAMEs so autoPatchelfHook can resolve them and the runtime loader can
      # find them for FoundationXML and lldb.
      mkSwiftCompatLibs = pkgs: pkgs.runCommand "swift-ubuntu-compat-libs" {
        nativeBuildInputs = [ pkgs.patchelf ];
      } ''
        mkdir -p "$out/lib"
        cp -L ${pkgs.lib.getLib pkgs.libxml2}/lib/libxml2.so.16 "$out/lib/libxml2.so.2"
        chmod u+w "$out/lib/libxml2.so.2"
        patchelf --set-soname libxml2.so.2 "$out/lib/libxml2.so.2"
        cp -L ${pkgs.lib.getLib pkgs.libedit}/lib/libedit.so.0 "$out/lib/libedit.so.2"
        chmod u+w "$out/lib/libedit.so.2"
        patchelf --set-soname libedit.so.2 "$out/lib/libedit.so.2"
      '';

      # A minimal Ubuntu-style sysroot: the swift.org driver looks for the C
      # library headers, startup objects, and the Swift runtime under
      # `<sysroot>/usr`, so the dev shell exports SDKROOT and the driver stops
      # warning that libc is missing.
      mkSwiftSysroot = pkgs: toolchain: pkgs.runCommand "swift-ubuntu-sysroot" { } ''
        mkdir -p "$out/usr/lib/swift" "$out/usr/lib/gcc"
        ln -s ${pkgs.glibc.dev}/include "$out/usr/include"
        ln -s ${toolchain}/lib/swift/linux "$out/usr/lib/swift/linux"
        for f in ${pkgs.glibc}/lib/* ${pkgs.stdenv.cc.cc.lib}/lib/*; do
          if [ -e "$f" ]; then
            ln -s "$f" "$out/usr/lib/$(basename "$f")"
          fi
        done
        ln -s ${pkgs.stdenv.cc.cc}/lib/gcc/* "$out/usr/lib/gcc/"
        # GNU ld prefixes absolute paths inside linker scripts with the
        # sysroot, so replace glibc's absolute-path scripts with relative ones.
        loader="$(cd "$out/usr/lib" && ls ld-linux-*.so.* 2>/dev/null | head -n1)"
        rm -f "$out/usr/lib/libc.so" "$out/usr/lib/libm.so"
        printf 'GROUP ( libc.so.6 libc_nonshared.a AS_NEEDED ( %s ) )\n' "$loader" \
          > "$out/usr/lib/libc.so"
        printf 'GROUP ( libm.so.6 AS_NEEDED ( libmvec.so.1 ) )\n' \
          > "$out/usr/lib/libm.so"
        ln -s lib "$out/usr/lib64"
      '';

      # The official Linux toolchain is built for Ubuntu 24.04 and expects the
      # system dynamic loader and shared libraries. autoPatchelfHook rewrites
      # every ELF file to the Nix store equivalents and keeps the toolchain's
      # own runtime libraries on the search path.
      mkSwiftToolchain = pkgs: system: pkgs.stdenv.mkDerivation {
        pname = "swift";
        version = swiftVersion;

        src = pkgs.fetchurl {
          inherit (swiftDistributions.${system}) url hash;
        };

        nativeBuildInputs = with pkgs; [
          autoPatchelfHook
        ];

        buildInputs = (with pkgs; [
          stdenv.cc.cc.lib # libstdc++ and libgcc_s
          (lib.getLib curl) # FoundationNetworking
          (lib.getLib libxml2) # FoundationXML and lldb
          (lib.getLib libedit) # lldb
          (lib.getLib sqlite)
          (lib.getLib ncurses)
          (lib.getLib zlib)
          (lib.getLib libuuid)
          (lib.getLib python312) # lldb Python bindings (Ubuntu 24.04 Python 3.12)
        ]) ++ [ (mkSwiftCompatLibs pkgs) ];

        strictDeps = true;
        dontConfigure = true;
        dontBuild = true;
        dontStrip = true;

        installPhase = ''
          runHook preInstall
          mkdir -p "$out"
          cp -a usr/. "$out/"
          runHook postInstall
        '';

        # The bundled Swift runtime lives outside $out/lib, so tell
        # autoPatchelfHook where to look before it patches the binaries.
        preFixup = ''
          addAutoPatchelfSearchPath "$out/lib/swift/linux"
          addAutoPatchelfSearchPath "$out/lib/swift/host"
          addAutoPatchelfSearchPath "$out/lib/swift/linux/x86_64"
          addAutoPatchelfSearchPath "$out/lib/swift/linux/aarch64"
        '';

        meta = {
          description = "Swift ${swiftVersion} compiler toolchain from swift.org";
          homepage = "https://swift.org";
          license = pkgs.lib.licenses.asl20;
          platforms = pkgs.lib.platforms.linux;
          mainProgram = "swift";
        };
      };

      mkDevShell = system:
        let
          pkgs = nixpkgs.legacyPackages.${system};
          isLinux = pkgs.stdenv.hostPlatform.isLinux;
          isDarwin = pkgs.stdenv.hostPlatform.isDarwin;

          # Linux takes the toolchain from the flake. macOS uses Xcode, matching
          # the `xcode-27` CI lane, and the hook fails fast when Xcode is missing
          # or carries a toolchain other than Swift 6.4.
          linuxShellHook = ''
            if [ "''${POSITRONICKIT_NIX_SHELL:-}" != "1" ]; then
              export POSITRONICKIT_NIX_SHELL=1
              export SDKROOT="${mkSwiftSysroot pkgs (mkSwiftToolchain pkgs system)}"
              echo "PositronicKit flake: $(swift --version 2>/dev/null | head -n1)"
              echo "Run 'make doctor' to validate the toolchain and its patched libraries."
            fi
          '';

          darwinShellHook = ''
            if [ "''${POSITRONICKIT_NIX_SHELL:-}" != "1" ]; then
              export POSITRONICKIT_NIX_SHELL=1
              if command -v xcrun >/dev/null 2>&1; then
                swift_version="$(xcrun swift --version 2>/dev/null \
                  | sed -nE 's/.*Swift version ([0-9]+\.[0-9]+).*/\1/p' | head -n1)"
                if [ "$swift_version" != "6.4" ]; then
                  echo "PositronicKit flake: Xcode Swift must be 6.4.x (found ''${swift_version:-unknown})." >&2
                  echo "Select Xcode 27 or run the pinned container instead." >&2
                  return 1 2>/dev/null || exit 1
                fi
                echo "PositronicKit flake: Xcode Swift $swift_version"
              else
                echo "PositronicKit flake: xcrun not found; install Xcode 27 first." >&2
                return 1 2>/dev/null || exit 1
              fi
            fi
          '';
        in
        pkgs.mkShell {
          packages = pkgs.lib.optionals isLinux [
            (mkSwiftToolchain pkgs system)
          ] ++ (with pkgs; [
            python3
            gnumake
            git
          ]);

          shellHook = pkgs.lib.optionalString isLinux linuxShellHook
            + pkgs.lib.optionalString isDarwin darwinShellHook;
        };
    in
    {
      packages = forAllSystems (system:
        let
          pkgs = nixpkgs.legacyPackages.${system};
        in
        pkgs.lib.optionalAttrs pkgs.stdenv.hostPlatform.isLinux {
          swift = mkSwiftToolchain pkgs system;
          default = mkSwiftToolchain pkgs system;
        });

      devShells = forAllSystems (system: {
        default = mkDevShell system;
      });
    };
}
